# Base64 encoding of "consumer_key:consumer_secret" from Lantmateriet's API portal.
SECRET=
STAC_TOKEN_URL=https://apimanager.lantmateriet.se/oauth2/token
STAC_SEARCH_URL=https://api.lantmateriet.se/stac-hojd/v1/search
# Ground elevation Cloud Optimized GeoTIFF collection (not DSM/laser data).
STAC_COLLECTION=dtm-cog

# Kolbe uses a 20 x 20 km world and a 129 x 129 terrain mesh.
RADIUS_KM=10
OUTPUT_SIZE=129
DEFAULT_TIMEOUT=60
PORT=8000
DOWNLOAD_WORKERS=8
PROCESSING_THREADS=4
# Read only the required blocks from Lantmateriet's cloud-optimized GeoTIFFs.
STREAM_COG=true
CACHE_DIR=.cache
