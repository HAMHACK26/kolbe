# Copy to .env and fill in SECRET. .env is gitignored.
# SECRET = base64("consumer_key:consumer_secret") from Lantmateriet's API portal.
SECRET=
STAC_TOKEN_URL=https://apimanager.lantmateriet.se/oauth2/token
STAC_SEARCH_URL=https://api.lantmateriet.se/stac-hojd/v1/search
# Ground-elevation Cloud Optimized GeoTIFF collection (not DSM/laser).
STAC_COLLECTION=dtm-cog
# Kolbe uses a 20x20 km world (10 km radius) and a 129x129 terrain grid.
RADIUS_KM=10
OUTPUT_SIZE=129
DEFAULT_TIMEOUT=120
